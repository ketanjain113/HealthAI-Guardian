# MongoDB Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/healthai-guardian

# Model API URLs (deployed separately on Railway)
MODEL_API_URL=https://healthai-models.railway.app
PREDICTION_API=https://healthai-models.railway.app/api/diagnose

# Backend API Configuration
NODE_ENV=production
PORT=5000

# Frontend API URLs (optional, used by React)
REACT_APP_API_URL=https://healthai-backend.railway.app
REACT_APP_MODEL_API_URL=https://healthai-models.railway.app

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# AI/LLM Services
GOOGLE_API_KEY=your_google_api_key
OPENROUTER_API_KEY=your_openrouter_key
OPENAI_API_KEY=your_openai_key
