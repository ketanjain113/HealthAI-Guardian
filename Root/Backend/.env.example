# Environment variables for Node.js Backend

# Server Configuration
PORT=8080
NODE_ENV=production

# MongoDB
MONGO_URI=mongodb://localhost:27017/healthai

# JWT
JWT_SECRET=your_jwt_secret_key_here_change_this_in_production

# Model API (Flask Python)
# For local development: http://localhost:5000
# For production on Railway: https://your-model-api-service.up.railway.app
MODEL_API_URL=http://localhost:5000

# AI Services (Optional)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
